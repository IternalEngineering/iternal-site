# Response headers for iternal.co.uk. Workers static assets parse this file; it is never served.
# The Content-Security-Policy-Report-Only line only logs to the browser console. Enforce it
# (rename to Content-Security-Policy) once a few days of browsing show no violations, and add
# any new third-party origin (fonts, scripts, form or API endpoints) to it first.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.iternal.co.uk https://formsubmit.co; frame-src 'self' https:; form-action 'self' https://api.iternal.co.uk https://formsubmit.co; base-uri 'self'; object-src 'none'

# Asset filenames aren't fingerprinted, so a day rather than a year.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
